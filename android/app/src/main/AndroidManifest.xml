<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Mağaza sürümünde de gerekli (Flutter yalnız debug/profile'a ekler). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android 13+: telefon bildirimi izni (FCM) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Fotoğraflar sistemin fotoğraf seçicisiyle seçilir; depolama/medya
         izni istenmez (Google Play fotoğraf izni politikası). -->
    <!-- Afişi galeriye kaydetme (gal): Android 10 ve üstünde izin gerekmez;
         yalnız eski sürümler için yazma izni. -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" tools:replace="android:maxSdkVersion" />
    <!-- Kimlik doğrulama: kimlik kartı çipini okuma (normal izin, soru
         çıkmaz). NFC'siz telefonlarda da uygulama kurulabilir. -->
    <uses-permission android:name="android.permission.NFC" />
    <uses-feature android:name="android.hardware.nfc" android:required="false" />
    <!-- Kimliğin arka yüzü canlı kamerayla okunur (camera eklentisi). Ses
         kaydı yapılmaz: eklentinin mikrofon izni çıkarılır. Kamerasız
         cihazlarda da kurulabilir. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" tools:node="remove" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />
    <queries>
        <!-- Afişi Instagram'da paylaş (hikâye / gönderi). -->
        <package android:name="com.instagram.android" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="geo" />
        </intent>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
    <application
        android:label="Lig Masası"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:requestLegacyExternalStorage="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- ligmasasi:// bağlantıları (katılım sayfasındaki "Lig Masası'nı aç"). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="ligmasasi"/>
            </intent-filter>
            <meta-data android:name="flutter_deeplinking_enabled" android:value="false"/>
        </activity>
        <!-- Afişin Instagram'a aktarılan geçici kopyası. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.igshare"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/ig_share_paths" />
        </provider>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
</manifest>
